# The database connection, written by the setup wizard. Holds a password.
instance/
# The old config file and whatever it was renamed to when it was imported
printer.config.json
printer.config.json.imported*

# Local telemetry database (holds job names / printer serial, no need to publish)
telemetry.db
*.db
*.sqlite
*.sqlite3

# Captured telemetry samples (may contain identifiers)
samples/

# go2rtc relay: binary is downloaded per-arch, config is generated from the settings
go2rtc/go2rtc_*
go2rtc.yaml

# Python
__pycache__/
*.pyc
.venv/
venv/
app*.log
app*.err
# JSON backups written by tools/backup.py - your data, not the code
backups/
